diff --git a/bpftrace_arm64.config b/bpftrace_arm64.config
index 40d709c..15772f5 100644
--- a/bpftrace_arm64.config
+++ b/bpftrace_arm64.config
@@ -229,3 +229,128 @@ tracepoint:syscalls:sys_exit_statx
     printf("{\"event\":\"STATX\",\"phase\":\"exit\",\"ts\":%llu,\"cgroup\":%llu,\"pid\":%d,\"ppid\":%d,\"start_time\":%llu,\"parent_start_time\":%llu,\"ret\":%d,\"stx_mode\":%u}\n", nsecs, cgroup, $pid, ((struct task_struct*)curtask)->real_parent->tgid, ((struct task_struct*)curtask)->start_boottime, ((struct task_struct*)curtask)->real_parent->start_boottime, args.ret, $mode);
     $discard = delete(@statx_buffer[tid]);
 }
+
+tracepoint:syscalls:sys_enter_execve
+/comm != "bpftrace"  /
+{
+    $ppid = ((struct task_struct*)curtask)->real_parent->tgid;
+    $start_time = ((struct task_struct*)curtask)->start_boottime;
+    $parent_start_time = ((struct task_struct*)curtask)->real_parent->start_boottime;
+    $argv = (uint64)args.argv;
+    $argv0 = str(uptr(*(uint64*)uptr($argv)));
+    $argv1 = str(uptr(*(uint64*)uptr($argv + 8)));
+    $argv2 = str(uptr(*(uint64*)uptr($argv + 16)));
+    $argv3 = str(uptr(*(uint64*)uptr($argv + 24)));
+    @execve_filename[tid] = args.filename;
+    @execve_argv0[tid] = $argv0;
+    @execve_argv1[tid] = $argv1;
+    @execve_argv2[tid] = $argv2;
+    @execve_argv3[tid] = $argv3;
+    printf("{\"event\":\"EXECVE\",\"ts\":%llu,\"cgroup\":%llu,\"pid\":%d,\"ppid\":%d,\"start_time\":%llu,\"parent_start_time\":%llu,\"uid\":%d,\"gid\":%d,\"comm\":\"%s\",\"raw_filepath\":\"%s\",\"argv0\":\"%s\",\"argv1\":\"%s\",\"argv2\":\"%s\",\"argv3\":\"%s\"}\n", nsecs, cgroup, pid, $ppid, $start_time, $parent_start_time, uid, gid, comm, str(args.filename), $argv0, $argv1, $argv2, $argv3);
+}
+
+tracepoint:syscalls:sys_enter_execveat
+/comm != "bpftrace"  /
+{
+    $argv = (uint64)args.argv;
+    @execveat_fd[tid] = args.fd;
+    @execveat_flags[tid] = args.flags;
+    @execveat_filename[tid] = args.filename;
+    @execveat_argv0[tid] = str(uptr(*(uint64*)uptr($argv)));
+    @execveat_argv1[tid] = str(uptr(*(uint64*)uptr($argv + 8)));
+    @execveat_argv2[tid] = str(uptr(*(uint64*)uptr($argv + 16)));
+    @execveat_argv3[tid] = str(uptr(*(uint64*)uptr($argv + 24)));
+}
+
+tracepoint:syscalls:sys_exit_execve
+/@execve_filename[tid]/
+{
+    printf("{\"event\":\"EXECVE\",\"phase\":\"exit\",\"ts\":%llu,\"cgroup\":%llu,\"pid\":%d,\"comm\":\"%s\",\"raw_filepath\":\"%s\",\"argv0\":\"%s\",\"argv1\":\"%s\",\"argv2\":\"%s\",\"argv3\":\"%s\",\"ret\":%lld}\n", nsecs, cgroup, pid, comm, str(@execve_filename[tid]), str(@execve_argv0[tid]), str(@execve_argv1[tid]), str(@execve_argv2[tid]), str(@execve_argv3[tid]), args.ret);
+    delete(@execve_filename[tid]);
+    delete(@execve_argv0[tid]);
+    delete(@execve_argv1[tid]);
+    delete(@execve_argv2[tid]);
+    delete(@execve_argv3[tid]);
+}
+
+tracepoint:syscalls:sys_exit_execveat
+/@execveat_filename[tid]/
+{
+    printf("{\"event\":\"EXECVEAT\",\"phase\":\"exit\",\"ts\":%llu,\"cgroup\":%llu,\"pid\":%d,\"comm\":\"%s\",\"fd\":%d,\"raw_filepath\":\"%s\",\"argv0\":\"%s\",\"argv1\":\"%s\",\"argv2\":\"%s\",\"argv3\":\"%s\",\"flags\":%d,\"ret\":%lld}\n", nsecs, cgroup, pid, comm, @execveat_fd[tid], str(@execveat_filename[tid]), str(@execveat_argv0[tid]), str(@execveat_argv1[tid]), str(@execveat_argv2[tid]), str(@execveat_argv3[tid]), @execveat_flags[tid], args.ret);
+    delete(@execveat_fd[tid]);
+    delete(@execveat_flags[tid]);
+    delete(@execveat_filename[tid]);
+    delete(@execveat_argv0[tid]);
+    delete(@execveat_argv1[tid]);
+    delete(@execveat_argv2[tid]);
+    delete(@execveat_argv3[tid]);
+}
+
+tracepoint:syscalls:sys_enter_fork
+/comm != "bpftrace"  /
+{
+    @fork_ts[tid] = nsecs;
+    @fork_cgroup[tid] = cgroup;
+    @fork_parent_pid[tid] = pid;
+    @fork_parent_start_time[tid] = ((struct task_struct*)curtask)->start_boottime;
+    @fork_clone_flags[tid] = 0;
+    @fork_uid[tid] = uid;
+    @fork_gid[tid] = gid;
+    @fork_comm[tid] = comm;
+}
+
+tracepoint:syscalls:sys_exit_fork
+/@fork_ts[tid]/
+{
+    $child_pid = args.ret;
+    if ($child_pid > 0) { printf("{\"event\":\"FORK\",\"syscall\":\"fork\",\"ts\":%llu,\"cgroup\":%llu,\"pid\":%d,\"child_pid\":%d,\"ppid\":%d,\"start_time\":0,\"parent_start_time\":%llu,\"uid\":%d,\"gid\":%d,\"comm\":\"%s\",\"clone_flags\":%llu}\n", @fork_ts[tid], @fork_cgroup[tid], $child_pid, $child_pid, @fork_parent_pid[tid], @fork_parent_start_time[tid], @fork_uid[tid], @fork_gid[tid], @fork_comm[tid], @fork_clone_flags[tid]); }
+    delete(@fork_ts[tid]);
+    delete(@fork_cgroup[tid]);
+    delete(@fork_parent_pid[tid]);
+    delete(@fork_parent_start_time[tid]);
+    delete(@fork_clone_flags[tid]);
+    delete(@fork_uid[tid]);
+    delete(@fork_gid[tid]);
+    delete(@fork_comm[tid]);
+}
+
+tracepoint:syscalls:sys_enter_vfork
+/comm != "bpftrace"  /
+{
+    @vfork_ts[tid] = nsecs;
+    @vfork_cgroup[tid] = cgroup;
+    @vfork_parent_pid[tid] = pid;
+    @vfork_parent_start_time[tid] = ((struct task_struct*)curtask)->start_boottime;
+    @vfork_clone_flags[tid] = 16384;
+    @vfork_uid[tid] = uid;
+    @vfork_gid[tid] = gid;
+    @vfork_comm[tid] = comm;
+}
+
+tracepoint:syscalls:sys_exit_vfork
+/@vfork_ts[tid]/
+{
+    $child_pid = args.ret;
+    if ($child_pid > 0) { printf("{\"event\":\"FORK\",\"syscall\":\"vfork\",\"ts\":%llu,\"cgroup\":%llu,\"pid\":%d,\"child_pid\":%d,\"ppid\":%d,\"start_time\":0,\"parent_start_time\":%llu,\"uid\":%d,\"gid\":%d,\"comm\":\"%s\",\"clone_flags\":%llu}\n", @vfork_ts[tid], @vfork_cgroup[tid], $child_pid, $child_pid, @vfork_parent_pid[tid], @vfork_parent_start_time[tid], @vfork_uid[tid], @vfork_gid[tid], @vfork_comm[tid], @vfork_clone_flags[tid]); }
+    delete(@vfork_ts[tid]);
+    delete(@vfork_cgroup[tid]);
+    delete(@vfork_parent_pid[tid]);
+    delete(@vfork_parent_start_time[tid]);
+    delete(@vfork_clone_flags[tid]);
+    delete(@vfork_uid[tid]);
+    delete(@vfork_gid[tid]);
+    delete(@vfork_comm[tid]);
+}
+
+tracepoint:syscalls:sys_enter_clone
+/comm != "bpftrace"  /
+{
+    @clone_ts[tid] = nsecs;
+    @clone_cgroup[tid] = cgroup;
+    @clone_parent_pid[tid] = pid;
+    @clone_parent_start_time[tid] = ((struct task_struct*)curtask)->start_boottime;
+    @clone_flags[tid] = args.clone_flags;
+    @clone_uid[tid] = uid;
+    @clone_gid[tid] = gid;
+    @clone_comm[tid] = comm;
+}
