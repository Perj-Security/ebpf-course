tracepoint:syscalls:sys_enter_execve
/comm != "bpftrace"  /
{
    $ppid = ((struct task_struct*)curtask)->real_parent->tgid;
    $start_time = ((struct task_struct*)curtask)->start_boottime;
    $parent_start_time = ((struct task_struct*)curtask)->real_parent->start_boottime;
    $argv = (uint64)args.argv;
    $argv0 = str(uptr(*(uint64*)uptr($argv)));
    $argv1 = str(uptr(*(uint64*)uptr($argv + 8)));
    $argv2 = str(uptr(*(uint64*)uptr($argv + 16)));
    $argv3 = str(uptr(*(uint64*)uptr($argv + 24)));
    @execve_pending[tid] = 1;
    @execve_filename[tid] = str(args.filename);
    @execve_argv0[tid] = $argv0;
    @execve_argv1[tid] = $argv1;
    @execve_argv2[tid] = $argv2;
    @execve_argv3[tid] = $argv3;
    printf("{\"event\":\"EXECVE\",\"ts\":%llu,\"cgroup\":%llu,\"pid\":%d,\"ppid\":%d,\"start_time\":%llu,\"parent_start_time\":%llu,\"uid\":%d,\"gid\":%d,\"comm\":\"%s\",\"raw_filepath\":\"%s\",\"argv0\":\"%s\",\"argv1\":\"%s\",\"argv2\":\"%s\",\"argv3\":\"%s\"}\n", nsecs, cgroup, pid, $ppid, $start_time, $parent_start_time, uid, gid, comm, str(args.filename), $argv0, $argv1, $argv2, $argv3);
}

