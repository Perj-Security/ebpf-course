tracepoint:syscalls:sys_enter_newfstatat
/comm != "bpftrace"   && comm != "kubelet" && comm != "containerd" && comm != "containerd-shim" && strncmp(comm, "runc", 4) != 0/
{
    $pid = ((struct task_struct*)curtask)->tgid;
    $ppid = ((struct task_struct*)curtask)->real_parent->tgid;
    $start_time = ((struct task_struct*)curtask)->start_boottime;
    $parent_start_time = ((struct task_struct*)curtask)->real_parent->start_boottime;
    if ((int64)args.dfd == -100) {
        if ((uint64)args.flag == 0x100) {
            printf("{\"event\":\"LSTAT\",\"phase\":\"enter\",\"ts\":%llu,\"cgroup\":%llu,\"pid\":%d,\"ppid\":%d,\"start_time\":%llu,\"parent_start_time\":%llu,\"uid\":%d,\"gid\":%d,\"comm\":\"%s\",\"raw_filepath\":\"%s\"}\n", nsecs, cgroup, $pid, $ppid, $start_time, $parent_start_time, uid, gid, comm, str(args.filename));
            @fstatat_kind[tid] = 2;
        } else {
            printf("{\"event\":\"STAT\",\"phase\":\"enter\",\"ts\":%llu,\"cgroup\":%llu,\"pid\":%d,\"ppid\":%d,\"start_time\":%llu,\"parent_start_time\":%llu,\"uid\":%d,\"gid\":%d,\"comm\":\"%s\",\"raw_filepath\":\"%s\"}\n", nsecs, cgroup, $pid, $ppid, $start_time, $parent_start_time, uid, gid, comm, str(args.filename));
            @fstatat_kind[tid] = 1;
        }
    } else {
        printf("{\"event\":\"FSTATAT\",\"phase\":\"enter\",\"ts\":%llu,\"cgroup\":%llu,\"pid\":%d,\"ppid\":%d,\"start_time\":%llu,\"parent_start_time\":%llu,\"uid\":%d,\"gid\":%d,\"comm\":\"%s\",\"dfd\":%d,\"raw_filepath\":\"%s\",\"flags\":%d}\n", nsecs, cgroup, $pid, $ppid, $start_time, $parent_start_time, uid, gid, comm, args.dfd, str(args.filename), args.flag);
        @fstatat_kind[tid] = 3;
    }
    @fstatat_ts[tid] = nsecs;
    @fstatat_cgroup[tid] = cgroup;
    @fstatat_pid[tid] = $pid;
    @fstatat_ppid[tid] = $ppid;
    @fstatat_start_time[tid] = $start_time;
    @fstatat_parent_start_time[tid] = $parent_start_time;
    @fstatat_uid[tid] = uid;
    @fstatat_gid[tid] = gid;
    @fstatat_comm[tid] = comm;
    @fstatat_dfd[tid] = args.dfd;
    @fstatat_filename[tid] = args.filename;
    @fstatat_flags[tid] = args.flag;
}

tracepoint:syscalls:sys_exit_newfstatat
{
    $pid = ((struct task_struct*)curtask)->tgid;
    $kind = @fstatat_kind[tid];
    if ($kind == 2) {
        printf("{\"event\":\"LSTAT\",\"phase\":\"exit\",\"ts\":%llu,\"cgroup\":%llu,\"pid\":%d,\"ret\":%d}\n", @fstatat_ts[tid], @fstatat_cgroup[tid], $pid, args.ret);
    } else if ($kind == 1) {
        printf("{\"event\":\"STAT\",\"phase\":\"exit\",\"ts\":%llu,\"cgroup\":%llu,\"pid\":%d,\"ret\":%d}\n", @fstatat_ts[tid], @fstatat_cgroup[tid], $pid, args.ret);
    } else {
        printf("{\"event\":\"FSTATAT\",\"phase\":\"exit\",\"ts\":%llu,\"cgroup\":%llu,\"pid\":%d,\"ret\":%d}\n", @fstatat_ts[tid], @fstatat_cgroup[tid], $pid, args.ret);
    }
    $discard = delete(@fstatat_ts[tid]);
    $discard = delete(@fstatat_cgroup[tid]);
    $discard = delete(@fstatat_pid[tid]);
    $discard = delete(@fstatat_ppid[tid]);
    $discard = delete(@fstatat_start_time[tid]);
    $discard = delete(@fstatat_parent_start_time[tid]);
    $discard = delete(@fstatat_uid[tid]);
    $discard = delete(@fstatat_gid[tid]);
    $discard = delete(@fstatat_comm[tid]);
    $discard = delete(@fstatat_dfd[tid]);
    $discard = delete(@fstatat_filename[tid]);
    $discard = delete(@fstatat_flags[tid]);
    $discard = delete(@fstatat_kind[tid]);
}

