/comm != "bpftrace"   && comm != "kubelet" && comm != "containerd" && comm != "containerd-shim" && strncmp(comm, "runc", 4) != 0/
{
    $pid = ((struct task_struct*)curtask)->tgid;
    $ppid = ((struct task_struct*)curtask)->real_parent->tgid;
    $start_time = ((struct task_struct*)curtask)->start_boottime;
    $parent_start_time = ((struct task_struct*)curtask)->real_parent->start_boottime;
    $flags = 0;
    $pidfd = 0;
    $child_tid = 0;
    $parent_tid = 0;
    $exit_signal = 0;
    $stack = 0;
    $stack_size = 0;
    $tls = 0;
    $set_tid = 0;
    $set_tid_size = 0;
    $cgroup = 0;
    if (args.uargs != 0) {
        $clone_args = (struct clone_args*)uptr(args.uargs);
        if (args.size >= 8) { $flags = $clone_args->flags; }
        if (args.size >= 16) { $pidfd = $clone_args->pidfd; }
        if (args.size >= 24) { $child_tid = $clone_args->child_tid; }
        if (args.size >= 32) { $parent_tid = $clone_args->parent_tid; }
        if (args.size >= 40) { $exit_signal = $clone_args->exit_signal; }
        if (args.size >= 48) { $stack = $clone_args->stack; }
        if (args.size >= 56) { $stack_size = $clone_args->stack_size; }
        if (args.size >= 64) { $tls = $clone_args->tls; }
        if (args.size >= 72) { $set_tid = $clone_args->set_tid; }
        if (args.size >= 80) { $set_tid_size = $clone_args->set_tid_size; }
        if (args.size >= 88) { $cgroup = $clone_args->cgroup; }
    }
    printf("{\"event\":\"CLONE3\",\"phase\":\"enter\",\"ts\":%llu,\"cgroup\":%llu,\"pid\":%d,\"ppid\":%d,\"start_time\":%llu,\"parent_start_time\":%llu,\"uid\":%d,\"gid\":%d,\"comm\":\"%s\",\"uargs\":%llu,\"size\":%llu,\"flags\":%llu,\"pidfd\":%llu,\"child_tid\":%llu,\"parent_tid\":%llu,\"exit_signal\":%llu,\"stack\":%llu,\"stack_size\":%llu,\"tls\":%llu,\"set_tid\":%llu,\"set_tid_size\":%llu,\"clone_cgroup\":%llu}\n", nsecs, cgroup, $pid, $ppid, $start_time, $parent_start_time, uid, gid, comm, (uint64)args.uargs, args.size, $flags, $pidfd, $child_tid, $parent_tid, $exit_signal, $stack, $stack_size, $tls, $set_tid, $set_tid_size, $cgroup);
}

